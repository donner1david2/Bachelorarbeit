@startuml
title Serverstruktur

skinparam componentStyle rectangle
skinparam shadowing false

actor "HB10" as HB10
actor "Browser" as Browser

package "DartVideoServerApplication :8082" {
    component "VideoController\n/api/v1/video\n\nPOST /{playerId}/{filename}\nGET /{playerId}/{filename}\nGET /videos" as VC
    component "SpaController\nWeiterleitung an /index.html" as SPA
    component "VideoRepository\nJpaRepository" as Repo
    component "Video\nJPA-Entität" as VideoEntity

    VC --> Repo : save / findAll
    Repo --> VideoEntity
}

database "PostgreSQL\nvideodb" as DB
component "Dateisystem\n.m3u8 / .ts" as FS

HB10 --> VC : Upload
VC --> VC : Metadaten / HLS
Browser --> SPA : Webanfrage

Repo --> DB : Metadaten
VC --> FS : Dateien

@enduml
